# Lokale Postgres-Instanz (npm run db:start)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/cleaninghub
# Zufallswert, z. B. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# KI-Fotoprüfung über Mistral – standardmäßig aus. Nur mit KI_FOTOPRUEFUNG=an UND Key werden Fotos an Mistral geschickt.
KI_FOTOPRUEFUNG=aus
MISTRAL_API_KEY=
MISTRAL_VISION_MODEL=ministral-14b-latest
# Ablage der Fotos
STORAGE_DIR=./storage
